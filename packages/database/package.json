{
  "name": "@drone-works/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "corepack pnpm run build && node scripts/migrate.mjs",
    "test:database": "corepack pnpm run build && node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.15.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
